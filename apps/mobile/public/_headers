# Web build (decision 0039), read by Cloudflare Pages. The database runs SQLite
# in a worker and waits on it with SharedArrayBuffer, which browsers allow only
# on a cross-origin isolated page: these two headers make it one.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The service worker and its file list must be fetched fresh, so a new build
# reaches the phone on its next open.
/sw.js
  Cache-Control: no-cache
/precache.json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
