{
  "expo": {
    "name": "Money Plant",
    "slug": "money-plant",
    "scheme": "moneyplant",
    "version": "0.8.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dd0e39dd-086f-40f0-b590-bc23dfb6644d"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.moneyplant.app"
    },
    "android": {
      "package": "in.moneyplant.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D1F1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1D1F1E",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1D1F1E"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Money Plant to use Face ID to unlock the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Money Plant to use the camera to scan UPI QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Money Plant to open a photo of a UPI QR code.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dd0e39dd-086f-40f0-b590-bc23dfb6644d"
      }
    },
    "owner": "devanand_1508"
  }
}
